#!/usr/bin/env bash
# install: sets up homelab on this machine, one checked step at a time. Run it again any time: it
# changes only what's different, and keeps your settings, your alarm topic and your photos. Run from
# a clone at /opt/homelab/src, it also sets up the daily update (README: "A new device").
#
#   sudo ./install                 the camera, its alarms and its page
#   sudo ./install alarm           only the alarm command (another machine that should raise alarms)
#   sudo ./install remove [--yes]  take everything away again
#
#   --topic                        use an alarm topic you have (after a wipe, or for another machine):
#                                  it asks for it, so it never shows on a command line
set -euo pipefail

here=$(cd "$(dirname "$0")" && pwd)
MJPG_REPO=https://github.com/350d/mjpg-streamer.git
MJPG_COMMIT=3f178a01873149ce95c9defd2525c1795bfea9ad # tested on homepi, 2026-10-12
ETC=/etc/homelab OPT=/opt/homelab VAR=/var/lib/homelab UNITS=/etc/systemd/system
URL_RE='^https?://[A-Za-z0-9.:-]+/[A-Za-z0-9_-]{1,64}$'
SERVICES=(homelab-firewall.service homelab-camera.service homelab-motion.path homelab-check.timer homelab-api.socket)

step() { printf '\n%s\n' "$*"; }
ok() { printf '  ✓ %s\n' "$*"; }
warn() { printf '  ! %s\n' "$*"; }
fail() { printf '  ✗ %s\n' "$*" >&2; exit 1; }
usage() { sed -n '2,9s/^# \{0,1\}//p' "$0"; exit "${1:-0}"; }

mode=all topic='' yes='' new_topic=''
asked=("$@")
while [ $# -gt 0 ]; do
  case $1 in
    alarm | remove) mode=$1 ;;
    --topic) topic=ask ;;
    --yes) yes=1 ;;
    -h | --help) usage ;;
    *) printf 'unknown: %s\n\n' "$1" >&2; usage 2 ;;
  esac
  shift
done

[ "$(id -u)" = 0 ] || fail "run it with sudo: sudo $0 ${asked[*]}"
if ! command -v apt-get >/dev/null || ! command -v systemctl >/dev/null; then
  fail "this needs Linux with apt and systemd (Ubuntu, Debian, Raspberry Pi OS)"
fi

packages() {
  local missing=() p
  for p in "$@"; do # there if apt has it, or its command is in /usr/bin (pkgconf gives pkg-config)
    dpkg-query -W -f='${Status}' "$p" 2>/dev/null | grep -q 'ok installed' || [ -x "/usr/bin/$p" ] ||
      missing+=("$p")
  done
  if [ "${#missing[@]}" -gt 0 ]; then
    echo "  installing ${missing[*]}"
    if ! { apt-get update -qq && apt-get install -y -qq --no-install-recommends "${missing[@]}" >/dev/null; }; then
      fail "couldn't install ${missing[*]}: check the internet, then run this again"
    fi
  fi
  ok "packages: $*"
}

page_url() {
  local name
  name=$(tailscale status --json 2>/dev/null | jq -r '.Self.DNSName // empty' | sed 's/\.$//')
  [ -z "$name" ] || echo "https://$name:8443"
}

alarms() {
  step "Alarms"
  install -d -m 755 "$ETC"
  if ! getent group alarm >/dev/null; then groupadd --system alarm && touch "$ETC/.made-alarm-group"; fi
  ok "group alarm: root and its members may send alarms"
  local conf=$ETC/alarm.conf url=
  if [ -n "$topic" ]; then
    if [ -t 0 ]; then read -r -s -p "  Your topic (as ntfy shows it; it won't show here): " topic; echo
    else read -r topic; fi
    [ -n "$topic" ] || fail "no topic given"
    case $topic in *://*) url=$topic ;; *) url=https://ntfy.sh/$topic ;; esac
  elif [ -r "$conf" ]; then
    url=$(sed -n 's/^ALARM_URL=//p' "$conf" | tail -n 1)
  fi
  if [ -z "$url" ]; then
    url=https://ntfy.sh/homelab-$(od -An -N12 -tx1 /dev/urandom | tr -d ' \n')
    new_topic=1
  fi
  [[ $url =~ $URL_RE ]] || fail "that isn't a topic: use letters, digits, - and _ (up to 64)"
  (
    umask 027
    printf '# Your alarm topic. Whoever knows it can read your alarms: keep it private.\nALARM_URL=%s\n' "$url" > "$conf.new"
  )
  chown root:alarm "$conf.new" && mv "$conf.new" "$conf"
  ok "topic: ${new_topic:+new, }in $conf (only root and the alarm group can read it)"
  curl --help all 2>/dev/null | grep -q -- '--url-query' || fail "curl is too old (7.87 or later): sudo apt-get install curl"
  install -m 755 "$here/bin/alarm" /usr/local/bin/alarm
  ok "command: alarm \"title\" \"message\" [photo]"
}

updates() {
  step "Updates"
  if [ "$here" != "$OPT/src" ] || ! git -C "$here" rev-parse -q --verify HEAD >/dev/null 2>&1; then
    warn "no daily updates: this copy isn't a clone at $OPT/src (README: \"A new device\")"
    return
  fi
  [ "$(stat -c %u "$here")" = 0 ] || fail "$here must belong to root: it runs as root"
  install -d -m 755 "$OPT/lib"
  install -m 755 "$here/lib/update" "$OPT/lib/"
  install -m 644 "$here/systemd/homelab-update.service" "$here/systemd/homelab-update.timer" "$UNITS/"
  systemctl daemon-reload
  systemctl enable -q --now homelab-update.timer
  ok "daily, from main: the next run is $(systemctl show homelab-update.timer -p NextElapseUSecRealtime --value)"
}

done_with() { # what's installed now, for the daily update; and how this machine is set up
  echo "$mode" > "$ETC/mode"
  git -C "$here" rev-parse -q --verify HEAD > "$OPT/installed" 2>/dev/null || rm -f "$OPT/installed"
}

subscribe() { # shows the topic to you only at a terminal, when it's new
  [ -n "$new_topic" ] || return 0
  if [ -t 0 ] && [ -t 1 ]; then
    local url server
    url=$(sed -n 's/^ALARM_URL=//p' "$ETC/alarm.conf")
    server=${url#*://} server=${server%%/*}
    step "Subscribe on your phone"
    echo "  In the ntfy app: tap +, enter the topic ${url##*/}, and tap Subscribe."
    [ "$server" = ntfy.sh ] || echo "  Use another server: $server"
    read -r -p "  Press Enter when you've subscribed: " _
  else
    warn "subscribe in the ntfy app to the topic in $ETC/alarm.conf (sudo cat it)"
  fi
}

camera_user() {
  step "Camera user"
  id homelab >/dev/null 2>&1 ||
    useradd --system --user-group --no-create-home --home-dir /nonexistent --shell /usr/sbin/nologin homelab
  usermod -aG video,alarm homelab
  ok "homelab: no login, no sudo; it can use the camera and send alarms, nothing else"
}

build() {
  step "Camera program (mjpg-streamer ${MJPG_COMMIT:0:7})"
  if [ "$(cat "$OPT/mjpg/commit" 2>/dev/null)" = "$MJPG_COMMIT" ]; then
    ok "already built"
    return
  fi
  local builder=${SUDO_USER:-nobody} tmp
  tmp=$(mktemp -d)
  chown "$builder" "$tmp"
  echo "  building as $builder (a minute or two)"
  # shellcheck disable=SC2016 # the inner script gets its values as arguments
  runuser -u "$builder" -- env -i PATH=/usr/bin:/bin HOME="$tmp" bash -euc '
    git init -q "$1/src" && cd "$1/src"
    git fetch -q --depth 1 "$2" "$3" && git checkout -q FETCH_HEAD
    [ "$(git rev-parse HEAD)" = "$3" ]
    cmake -S . -B build -DCMAKE_BUILD_TYPE=Release -DCMAKE_POSITION_INDEPENDENT_CODE=ON
    cmake --build build -j "$(nproc)"' _ "$tmp" "$MJPG_REPO" "$MJPG_COMMIT" > "$tmp/build.log" 2>&1 || {
    tail -n 20 "$tmp/build.log" >&2
    rm -rf "$tmp"
    fail "the build failed: the end of its log is above"
  }
  install -d -m 755 "$OPT/mjpg/plugins"
  install -m 755 "$tmp/src/build/mjpg_streamer" "$OPT/mjpg/"
  local p
  for p in input_uvc output_http output_motion; do
    install -m 755 "$tmp/src/build/plugins/$p.so" "$OPT/mjpg/plugins/"
  done
  echo "$MJPG_COMMIT" > "$OPT/mjpg/commit"
  rm -rf "$tmp"
  ok "built into $OPT/mjpg"
}

files() {
  step "Files"
  install -d -m 755 "$OPT/lib" "$OPT/www"
  install -m 755 "$here"/lib/{camera-run,motion-send,check,firewall,api,motion-switch} "$OPT/lib/"
  install -m 644 "$here/www/index.html" "$OPT/www/"
  ok "$OPT: the programs and the page"
  if [ -f "$ETC/homelab.conf" ]; then
    local url
    url=$(page_url)
    if grep -q '^PAGE=$' "$ETC/homelab.conf" && [ -n "$url" ]; then
      sed -i "s|^PAGE=$|PAGE=$url|" "$ETC/homelab.conf"
      ok "$ETC/homelab.conf: kept your settings, and added the page's link"
    else
      ok "$ETC/homelab.conf: kept your settings"
    fi
  else
    local cam=/dev/video0 c
    for c in /dev/v4l/by-id/*-video-index0; do [ -e "$c" ] && cam=$c && break; done
    cat > "$ETC/homelab.conf" <<EOF
# Homelab settings. After a change: sudo systemctl restart homelab-camera
# The camera. Its by-id name stays the same when you plug it into another port.
CAMERA=$cam
SIZE=1280x720
FPS=15
# Motion (mjpg-streamer's motion plugin): --motion how much must change (%), --sequence frames
# in a row, --nframe check every nth frame, --downscale shrink first, --cooldown seconds between
# photos; --zones focuses on parts of the picture (README). Long names only: -l doesn't work.
MOTION="--downscale 4 --motion 5 --sequence 2 --nframe 2 --cooldown 120"
# Motion photos older than this many days are deleted.
KEEP_DAYS=7
# The page your phone opens when you tap an alarm.
PAGE=$(page_url)
EOF
    ok "$ETC/homelab.conf: written (camera $cam)"
  fi
  install -d -m 750 -o homelab -g homelab "$VAR" "$VAR/state" "$VAR/data" "$VAR/data/motion"
  [ -e "$VAR/state/motion-sent" ] || install -m 640 -o homelab -g homelab /dev/null "$VAR/state/motion-sent"
  ok "$VAR: photos and state, the homelab user's only"
  if [ ! -e "$VAR/data/motion.json" ]; then
    runuser -u homelab -- "$OPT/lib/motion-switch" off
    ok "motion alarms: off to start (turn them on from the page when you leave)"
  else
    ok "motion alarms: kept $(jq -r .motion "$VAR/data/motion.json")"
  fi
}

services() {
  step "Services"
  local u
  for u in "$here"/systemd/*; do
    case $u in *homelab-update.*) ;; *) install -m 644 "$u" "$UNITS/" ;; esac # updates(): clones only
  done
  systemctl daemon-reload
  systemctl enable -q "${SERVICES[@]}"
  if ! { systemctl restart homelab-firewall.service homelab-camera.service homelab-api.socket &&
    systemctl start homelab-motion.path; }; then
    fail "a service didn't start: journalctl -u 'homelab-*' -n 20"
  fi
  ok "camera, motion photos, check (every minute), switch, firewall: on now and at every start"
}

page() {
  step "Page (your devices only, through Tailscale)"
  if ! tailscale status >/dev/null 2>&1; then
    warn "no Tailscale here: no page (alarms still work). Set up Tailscale, then run this again"
    return
  fi
  tailscale status --json | jq -e '.CertDomains | length > 0' >/dev/null ||
    fail "turn on HTTPS for your tailnet (Tailscale admin console, DNS, HTTPS Certificates), then run this again"
  { tailscale serve --bg --https=8443 --set-path / "$OPT/www" &&
    tailscale serve --bg --https=8443 --set-path /data "$VAR/data" &&
    tailscale serve --bg --https=8443 --set-path /stream http://127.0.0.1:8080/stream &&
    tailscale serve --bg --https=8443 --set-path /snapshot http://127.0.0.1:8080/snapshot &&
    tailscale serve --bg --https=8443 --set-path /api http://127.0.0.1:8081/api; } >/dev/null ||
    fail "Tailscale didn't take the page (above)"
  local host
  host=$(page_url) host=${host#https://}
  tailscale serve status --json | jq -e --arg k "$host" '.Web[$k].Handlers | has("/") and has("/api")' >/dev/null ||
    fail "Tailscale doesn't show the page on port 8443: tailscale serve status"
  ok "https://$host"
}

checks() {
  step "Checks"
  local tmp snap
  tmp=$(mktemp -d)
  snap=$tmp/camera.jpg
  for _ in $(seq 20); do curl -sf -m 3 -o "$snap" http://127.0.0.1:8080/snapshot && break; sleep 1; done
  if [ -s "$snap" ]; then
    ok "the camera streams"
    local rc=0
    runuser -u nobody -- curl -s -m 3 -o /dev/null http://127.0.0.1:8080/snapshot || rc=$?
    [ "$rc" = 7 ] || fail "other users here can open the camera: the firewall isn't on (journalctl -u homelab-firewall)"
    ok "other users on this machine can't open it"
  else
    warn "the camera isn't streaming yet: $(journalctl -u homelab-camera -n 1 --no-pager -o cat)"
  fi
  [ "$(curl -s -m 5 -o /dev/null -w '%{http_code}' -X POST http://127.0.0.1:8081/api/motion/off)" = 403 ] ||
    fail "the page's switch doesn't answer: journalctl -u 'homelab-api*'"
  ok "the page's switch answers (and refuses requests not from the page)"
  systemctl start homelab-check.service || fail "the camera check failed: journalctl -u homelab-check"
  ok "the camera check ran"
  if [ -t 0 ] || [ -n "$new_topic" ]; then # at your terminal, or a new topic; not on a daily update
    if [ -s "$snap" ]; then
      alarm -p 3 -g house -u "$(page_url)" "Homelab is set up" "This is how alarms look; the photo is the camera now." "$snap"
    else
      alarm -p 3 -g house "Homelab is set up" "This is how alarms look. The camera isn't streaming yet."
    fi || fail "the test alarm didn't send (above)"
    ok "a test alarm went to your topic"
  fi
  rm -rf "$tmp"
  local url
  url=$(page_url)
  if [ -n "$url" ]; then
    if curl -sf -m 10 -o /dev/null "$url/"; then ok "the page answers: $url"
    else warn "the page didn't answer from here; open it on your phone: $url (tailscale serve status)"; fi
  fi
}

remove() {
  step "Remove homelab: its services, page, programs, settings, alarm topic, photos, user and group"
  if [ -z "$yes" ]; then
    [ -t 0 ] || fail "say --yes to remove without a question"
    read -r -p "  Type yes to remove it all: " answer
    [ "$answer" = yes ] || fail "nothing removed"
  fi
  systemctl stop "${SERVICES[@]}" homelab-update.timer homelab-check.service homelab-motion.service \
    homelab-update.service 'homelab-api@*' 2>/dev/null || true
  systemctl disable -q "${SERVICES[@]}" homelab-update.timer 2>/dev/null || true
  rm -f "$UNITS"/homelab-{firewall.service,camera.service,motion.path,motion.service,check.timer,check.service} \
    "$UNITS"/homelab-{api.socket,api@.service,update.service,update.timer}
  systemctl daemon-reload
  if [ -d "$OPT/www" ]; then tailscale serve --https=8443 off >/dev/null 2>&1 || true; fi
  local ours=''
  if [ -e "$ETC/.made-alarm-group" ]; then ours=1; fi
  rm -rf "$OPT" "$VAR" "$ETC"
  rm -f /usr/local/bin/alarm
  if id homelab >/dev/null 2>&1; then userdel homelab; fi
  if [ -n "$ours" ] && getent group alarm >/dev/null; then groupdel alarm; fi
  ok "removed. The build packages stay (apt autoremove won't take them; remove them by hand if you like)"
}

case $mode in
  remove) remove ;;
  alarm)
    step "Packages"
    packages curl git
    alarms
    subscribe
    updates
    if [ -t 0 ] || [ -n "$new_topic" ]; then
      alarm -p 3 -g bell "Alarms work on $(hostname)" "Anything on this machine can now run: alarm \"title\" \"message\"" ||
        fail "the test alarm didn't send (above)"
      ok "a test alarm went to your topic"
    fi
    install -d -m 755 "$OPT"
    done_with
    ;;
  all)
    # No camera alarms while it restarts; the check comes back however this ends.
    systemctl stop homelab-check.timer 2>/dev/null || true
    trap 'systemctl start homelab-check.timer 2>/dev/null || true' EXIT
    step "Packages"
    packages cmake build-essential git pkg-config libjpeg-dev libturbojpeg0-dev libcurl4-openssl-dev \
      v4l-utils curl jq nftables
    alarms
    subscribe
    camera_user
    build
    files
    services
    page
    checks
    updates
    done_with
    step "Done. Open the page and turn motion alarms on to try them: wave, and a photo arrives.
Unplug the camera: you hear within 3 minutes."
    ;;
esac
