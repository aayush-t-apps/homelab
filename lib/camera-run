#!/usr/bin/env bash
# homelab-camera: while the camera is on, the live stream on 127.0.0.1:8080 (mjpg-streamer) and,
# with its motion plugin, a photo of each movement in /var/lib/homelab/data/motion. systemd starts
# it only while the camera is on (homelab-camera.path). Waits while the camera is unplugged.
set -euo pipefail
# shellcheck source=/dev/null
. "${HOMELAB_CONF:-/etc/homelab/homelab.conf}"
m=/opt/homelab/mjpg on=/var/lib/homelab/state/camera-on

if [ ! -e "$CAMERA" ]; then
  echo "waiting for the camera at $CAMERA: plug it in"
  until [ -e "$CAMERA" ]; do
    [ -e "$on" ] || exit 0 # turned off while waiting
    sleep 5
  done
fi

exec "$m/mjpg_streamer" \
  -i "$m/plugins/input_uvc.so -d $CAMERA -r $SIZE -f $FPS" \
  -o "$m/plugins/output_http.so -l 127.0.0.1 -p 8080" \
  -o "$m/plugins/output_motion.so $MOTION --folder /var/lib/homelab/data/motion"
