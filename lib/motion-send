#!/usr/bin/env bash
# home-motion: a new motion photo, sent as an alarm (home-motion.path runs it when one lands).
# - The first WARMUP seconds after the camera starts are its light settling: those photos go.
# - Each alarm comes with a few more frames, a second apart (BURST), so you see what happened: all
#   go on the page, and the first of them, with whoever moved further in, goes to your phone. If the
#   camera can't give them, the first photo goes.
# - While something keeps moving, the page gets every photo and your phone an alarm at most every
#   ALARM_EVERY seconds, saying how many photos came since the last one.
# - An alarm that can't be sent stays to send with the next photo; the page shows why.
set -euo pipefail
# shellcheck source=/dev/null
. "${HOMELAB_DEFAULTS:-/opt/homelab/defaults.conf}"
# shellcheck source=/dev/null
. "${HOMELAB_CONF:-/etc/homelab/homelab.conf}"
var=${HOMELAB_VAR:-/var/lib/homelab}
alarm=${ALARM_BIN:-alarm}
url=${CAMERA_URL:-http://127.0.0.1:8080}
lib=${HOMELAB_LIB:-/opt/homelab/lib}
motion=$var/data/motion state=$var/state sent=$var/state/motion-sent last=$var/state/alarm-last

# A new file wakes this up as soon as it's created: give the camera a moment to finish writing it.
sleep "${SETTLE:-1}"
[ -e "$sent" ] || touch -d @0 "$sent"
[ -e "$last" ] || touch -d @0 "$last"

new_photos() { # oldest first
  find "$motion" -maxdepth 1 -name '*_motion_*.jpg' ! -name 'debug_*' -newer "$1" -printf '%T@ %p\n' |
    sort -n | cut -d' ' -f2-
}

while :; do
  mapfile -t new < <(new_photos "$sent")
  [ "${#new[@]}" -gt 0 ] || break
  latest=${new[-1]}

  started=$(cat "$state/camera-started" 2>/dev/null || echo 0)
  if [ "$(date -r "$latest" +%s)" -lt $(( started + ${WARMUP:-10} )) ]; then
    rm -f -- "${new[@]}" # the camera's light settling, not someone
    continue
  fi
  if [ $(( $(date +%s) - $(date -r "$last" +%s) )) -lt "${ALARM_EVERY:-120}" ]; then
    touch -r "$latest" "$sent" # on the page; the phone heard a moment ago
    continue
  fi

  # A few more frames, a second apart: who moved, and where they went.
  burst=()
  for i in $(seq 1 "${BURST:-2}"); do
    [ "$i" = 1 ] || sleep 1
    frame=$motion/$(date +%Y%m%d_%H%M%S)_motion_b$i.jpg
    if curl -sf -m 5 --retry 2 --retry-delay 0 --retry-all-errors -o "$frame.new" "$url/snapshot" && [ -s "$frame.new" ]; then
      mv "$frame.new" "$frame"
      burst+=("$frame")
    else
      rm -f "$frame.new"
    fi
  done
  photo=$latest newest=$latest
  if [ "${#burst[@]}" -gt 0 ]; then photo=${burst[0]} newest=${burst[-1]}; fi
  count=$(new_photos "$last" | wc -l)
  message="Seen at $(date -r "$latest" +%H:%M:%S). Tap to watch live."
  [ "$count" -le 2 ] || message+=" $count photos since the last alarm, on the page."

  if err=$("$alarm" -p 4 -g rotating_light -u "${PAGE:-}" "Motion at home" "$message" "$photo" 2>&1 >/dev/null); then
    touch -r "$newest" "$sent"
    touch "$last"
    rm -f "$state/alarm-error"
  else
    echo "$(date -Iseconds) ${err//$'\n'/ }" > "$state/alarm-error"
    echo "not sent: $err" >&2
    break
  fi
done
"$lib/status" # the page shows new photos now, not at the next check
