[Unit]
Description=Homelab camera: the live stream, and a photo of each movement; only while it's on
Requires=homelab-firewall.service
After=homelab-firewall.service network.target
# Never give up restarting a camera that's on.
StartLimitIntervalSec=0

[Service]
User=homelab
# Off means off: checked at every start, restarts after a stop included (a unit Condition is only
# checked on a fresh start, so a stopped camera came straight back). On: homelab-camera.path starts it.
ExecCondition=/usr/bin/test -e /var/lib/homelab/state/camera-on
ExecStart=/opt/homelab/lib/camera-run
Restart=always
RestartSec=3
ReadWritePaths=/var/lib/homelab
InaccessiblePaths=/etc/homelab/alarm.conf
# Sandboxed: no view of /home or /srv, nothing to change but its own folder.
ProtectSystem=strict
ProtectHome=yes
InaccessiblePaths=-/srv
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
